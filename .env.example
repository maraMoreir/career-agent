# =====================================================================
# Career Agent - configuracao por ambiente
# Copie este arquivo para `.env` e ajuste. NUNCA versione o `.env`.
# =====================================================================

# ---------------------------------------------------------------------
# Caminhos
# ---------------------------------------------------------------------
# Raiz de dados. TODO acesso a arquivos do MCP career-files fica preso
# (jailed) dentro deste diretorio. Nao aponte para C:\ ou para a home.
CAREER_DATA_ROOT=C:\career-agent\data

# Diretorio de logs (criado automaticamente).
CAREER_LOG_DIR=C:\career-agent\logs

# Nivel de log: DEBUG | INFO | WARNING | ERROR
CAREER_LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Scoring
# ---------------------------------------------------------------------
# Score minimo para o agente sugerir a vaga (0-100).
CAREER_MIN_SCORE=70

# ---------------------------------------------------------------------
# Busca de vagas
# ---------------------------------------------------------------------
# Habilita chamadas HTTP para APIs publicas de vagas.
# false  -> apenas a fonte `mock` (offline, deterministica) responde.
# true   -> habilita `remotive` e `arbeitnow` (APIs publicas, sem auth).
JOB_SEARCH_ENABLE_NETWORK=false

# Fontes ativas, separadas por virgula.
# Disponiveis: mock, remotive, arbeitnow
JOB_SEARCH_SOURCES=mock

# Timeout (segundos) por requisicao HTTP.
JOB_SEARCH_TIMEOUT=15

# Maximo de resultados por fonte, por busca. Mantem o uso educado (rate-friendly).
JOB_SEARCH_MAX_RESULTS=25

# Intervalo minimo entre requisicoes a uma mesma fonte, em segundos (rate limit).
JOB_SEARCH_MIN_INTERVAL=2.0

# User-Agent enviado as APIs publicas. Identifique-se honestamente.
JOB_SEARCH_USER_AGENT=career-agent/1.0 (personal job search; contact: troque-pelo-seu-email@exemplo.com)

# =====================================================================
# NAO EXISTEM VARIAVEIS DE CREDENCIAL DO LINKEDIN NESTE PROJETO.
# Login, cookies, tokens de sessao e automacao de cliques sao
# deliberadamente NAO suportados. Ver docs/SECURITY.md.
# =====================================================================
